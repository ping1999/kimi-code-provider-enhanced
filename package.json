{
  "name": "kimi-code-provider-enhanced",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "在 WebUI 对话中发现并选择供应商模型，配置思考档位。",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "test:unit": "node --test \"test/*.test.ts\"",
    "test:integration": "node scripts/integration.mjs",
    "test:web": "node scripts/web-fixture.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "24.3.0",
    "esbuild": "0.25.9",
    "typescript": "5.9.2"
  }
}
